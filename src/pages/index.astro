---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, LINKS } from '@/lib/constants';
import { SUMMITS, ORGANIZERS, SPEAKERS_2026, getKeynoteSpeakers } from '@/lib/summits-data';

const latestSummit = Object.values(SUMMITS).sort((a, b) => parseInt(b.year) - parseInt(a.year))[0];

const heroSpeakers = [
  ...getKeynoteSpeakers('2026'),
  ...SPEAKERS_2026.filter(s => s.photoUrl && !s.isKeynote).slice(0, 4),
].filter(s => s.photoUrl).slice(0, 6);

const applicationDomains = [
  { label: 'Mangrove Planting', color: 'from-emerald-500 to-green-600' },
  { label: 'Coral Regeneration', color: 'from-cyan-500 to-blue-500' },
  { label: 'Crop Planting', color: 'from-amber-500 to-orange-500' },
  { label: 'Waste Sorting', color: 'from-violet-500 to-purple-600' },
  { label: 'Wildfire Detection', color: 'from-red-500 to-rose-600' },
  { label: 'Ocean Observation', color: 'from-blue-500 to-teal-600' },
  { label: 'Energy Inspection', color: 'from-yellow-500 to-amber-600' },
  { label: 'Disaster Response', color: 'from-pink-500 to-rose-500' },
];
---

<BaseLayout title="Home" description={`${SITE.name} - ${SITE.tagline}. ${SITE.description}`}>
  {/* ─── HERO ─── */}
  <section class="relative overflow-hidden bg-crn-navy text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-crn-navy via-crn-blue-dark to-crn-blue"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 25% 25%, rgba(22,163,74,0.3), transparent 45%), radial-gradient(circle at 75% 75%, rgba(59,130,246,0.3), transparent 45%);"></div>

    <div class="relative container mx-auto px-4 py-20 lg:py-28">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-crn-green/15 border border-crn-green/40 rounded-full text-crn-green text-xs font-semibold uppercase tracking-wider mb-6">
            <span class="w-1.5 h-1.5 bg-crn-green rounded-full animate-pulse"></span>
            {SITE.stats.members} members · {SITE.stats.countries} countries
          </div>
          <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-6">
            Green Bots,
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-crn-green via-emerald-400 to-teal-300">Blue Planet.</span>
          </h1>
          <p class="text-lg md:text-xl text-white/75 max-w-2xl mb-10 leading-relaxed">
            An inclusive community connecting, enabling, and supporting climate robotics worldwide — researchers, engineers, entrepreneurs, and policymakers working at the intersection of autonomy and the climate crisis.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/slack"
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-crn-green text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-crn-green-dark transition-colors shadow-lg shadow-crn-green/25"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/></svg>
              Join Our Community
            </a>
            <a
              href="/summits"
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-white/20 transition-colors"
            >
              Watch Summit Videos
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-br from-crn-green/20 to-crn-blue/20 rounded-3xl blur-2xl"></div>
            <img
              src="/images/hero-robot-tree.webp"
              alt="Robotic hand nurturing a tree against a blue sky"
              class="relative w-full rounded-2xl shadow-2xl ring-1 ring-white/10"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── WHAT IS CLIMATE ROBOTICS ─── */}
  <section class="py-20 lg:py-28 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-12 gap-12 items-start max-w-7xl mx-auto">
        <div class="lg:col-span-5">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-blue mb-3">
            A New Field
          </div>
          <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-6 leading-tight">
            Robots alone won't<br/>clean up our mess.
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            <strong class="text-gray-900">Climate Robotics</strong> uses AI-powered autonomy to scale climate action — but only when deployed thoughtfully. We exist to understand the opportunities, limits, and risks of robotics for the climate crisis.
          </p>
          <p class="text-gray-600 mb-8 leading-relaxed">
            We champion diversity, inclusion, and equity across researching, developing, and deploying robotics to scale climate action.
          </p>
          <a href="/research" class="inline-flex items-center gap-2 text-crn-blue font-bold uppercase tracking-wider text-sm hover:underline">
            Read Our White Paper
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <div class="lg:col-span-7">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400 mb-4">
            Applications in the Wild
          </div>
          <div class="flex flex-wrap gap-2 mb-6">
            {applicationDomains.map(domain => (
              <span class={`inline-block px-4 py-2 text-sm font-semibold text-white rounded-full bg-gradient-to-r ${domain.color} shadow-sm`}>
                {domain.label}
              </span>
            ))}
          </div>
          <p class="text-gray-500 italic">
            From flying robots planting mangroves to underwater rovers regenerating coral reefs, climate robotics is already deployed across dozens of domains worldwide.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── LATEST SUMMIT SPOTLIGHT ─── */}
  {latestSummit && (
    <section class="py-20 lg:py-28 bg-gray-900 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 30% 50%, rgba(22,163,74,0.4), transparent 50%), radial-gradient(circle at 80% 80%, rgba(59,130,246,0.4), transparent 50%);"></div>

      <div class="relative container mx-auto px-4">
        <div class="grid lg:grid-cols-12 gap-12 items-center max-w-7xl mx-auto">
          <div class="lg:col-span-7 order-2 lg:order-1">
            <div class="grid grid-cols-3 gap-3">
              {heroSpeakers.map((s, i) => (
                <div class={`aspect-square rounded-2xl overflow-hidden ring-1 ring-white/10 shadow-xl ${i === 1 ? 'translate-y-6' : ''} ${i === 4 ? '-translate-y-6' : ''}`}>
                  <img src={s.photoUrl} alt={s.name} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>

          <div class="lg:col-span-5 order-1 lg:order-2">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-green mb-3">
              Just Wrapped
            </div>
            <h2 class="font-heading font-bold text-4xl md:text-5xl mb-4 leading-tight">
              Climate Robotics<br/>Summit {latestSummit.year}
            </h2>
            <p class="text-white/70 mb-2">{latestSummit.dates} · {latestSummit.location}</p>
            <p class="text-white/70 mb-8 leading-relaxed">
              {latestSummit.description}
            </p>
            <a
              href={`/summits/${latestSummit.year}`}
              class="inline-flex items-center gap-2 px-6 py-3 bg-white text-gray-900 font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-crn-green hover:text-white transition-colors"
            >
              Explore Summit {latestSummit.year}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* ─── WHITE PAPER + MAP — TWO-CARD FEATURE ─── */}
  <section class="py-20 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-6 max-w-6xl mx-auto">
        {/* White Paper card */}
        <a href="/research" class="group relative overflow-hidden rounded-2xl bg-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 p-8 md:p-10 flex flex-col">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-blue mb-3">
            2025 Research
          </div>
          <h3 class="font-heading font-bold text-2xl md:text-3xl text-gray-900 mb-3 leading-tight">
            The first comprehensive study on Climate Robotics
          </h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            A community-driven white paper investigating opportunities, limitations, and risks of robotics in climate action — fully revised for 2025.
          </p>
          <div class="aspect-video rounded-xl overflow-hidden bg-gray-100 mb-6 mt-auto">
            <img src="/images/white-paper-mosaic.png" alt="White Paper cover mosaic" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          </div>
          <span class="inline-flex items-center gap-1 text-crn-blue font-bold uppercase tracking-wider text-sm group-hover:gap-2 transition-all">
            Read White Paper
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </a>

        {/* Map card */}
        <a href="/map" class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-crn-blue to-crn-blue-dark text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 p-8 md:p-10 flex flex-col">
          <div class="absolute top-0 right-0 w-64 h-64 bg-crn-green/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
          <div class="relative">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-green mb-3">
              The Global Map
            </div>
            <h3 class="font-heading font-bold text-2xl md:text-3xl mb-3 leading-tight">
              200+ climate robotics organizations, mapped worldwide
            </h3>
            <p class="text-white/75 mb-6 leading-relaxed">
              Explore startups, labs, and research programs across continents. Filter by sector, country, or maturity to find collaborators near you.
            </p>
            <div class="aspect-video rounded-xl overflow-hidden bg-white/10 mb-6 mt-auto ring-1 ring-white/10">
              <img src="/images/global-map.png" alt="Global map preview" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300" loading="lazy" />
            </div>
            <span class="inline-flex items-center gap-1 text-white font-bold uppercase tracking-wider text-sm group-hover:gap-2 transition-all">
              Open the Map
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ─── IMPACT NUMBERS ─── */}
  <section class="py-20 bg-crn-navy text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-crn-navy via-crn-blue-dark to-crn-navy"></div>
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 30% 30%, rgba(22,163,74,0.3), transparent 50%), radial-gradient(circle at 70% 70%, rgba(59,130,246,0.3), transparent 50%);"></div>
    <div class="relative container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-crn-green mb-2 tabular-nums">{SITE.stats.members}</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Members</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-crn-green mb-2 tabular-nums">{SITE.stats.countries}</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Countries</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-crn-green mb-2 tabular-nums">{SITE.stats.sectors}</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Sectors</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-crn-green mb-2 tabular-nums">3</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Summits Held</div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── SLACK CTA ─── */}
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="relative overflow-hidden bg-gradient-to-br from-crn-blue to-crn-blue-dark rounded-3xl max-w-5xl mx-auto p-10 md:p-16">
        <div class="absolute top-0 right-0 w-64 h-64 bg-crn-green/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/10 rounded-full blur-2xl translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h2 class="font-heading font-bold text-3xl md:text-4xl text-white mb-3 leading-tight">
              Ready to join the movement?
            </h2>
            <p class="text-white/80 text-lg">
              {SITE.stats.members} climate-robotics practitioners are already in our Slack. Be Kind. Be a Giver. Get started in 30 seconds.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a href="/slack" class="inline-flex items-center gap-3 px-8 py-4 bg-white text-crn-blue font-bold uppercase tracking-wider rounded-lg hover:bg-crn-green hover:text-white transition-colors shadow-xl">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/></svg>
              Join Our Slack
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
