---
/**
 * Climate Robotics Summit 2026 Archive Page
 * 3-day program with embedded videos (when published), speakers, and sponsors.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProgramDay from '@/components/ProgramDay.astro';
import SpeakerCard from '@/components/SpeakerCard.astro';
import SponsorGrid from '@/components/SponsorGrid.astro';
import {
  SUMMITS,
  SUMMIT_2026_PROGRAM,
  SUMMIT_2026_VIDEOS,
  SPEAKERS_2026,
  SPONSORS_2026,
  getKeynoteSpeakers,
} from '@/lib/summits-data';
import { LINKS } from '@/lib/constants';

const summit = SUMMITS['2026'];
const keynoteSpeakers = getKeynoteSpeakers('2026');
const recordingsAvailable = SUMMIT_2026_VIDEOS.length > 0;

const tabs = [
  { id: 'program', label: 'Program', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { id: 'speakers', label: 'Speakers', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { id: 'sponsors', label: 'Sponsors', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
];
---

<BaseLayout
  title={summit?.name ?? 'Climate Robotics Summit 2026'}
  description={`${summit?.name} — ${summit?.dates}. ${summit?.tagline}`}
>
  {/* Hero Section */}
  <section class="relative overflow-hidden bg-crn-navy text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-crn-navy via-crn-blue-dark to-crn-blue"></div>
    <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 20% 30%, rgba(22,163,74,0.35), transparent 50%), radial-gradient(circle at 80% 70%, rgba(59,130,246,0.3), transparent 50%);"></div>

    <div class="relative container mx-auto px-4 py-20 lg:py-28">
      <a href="/summits" class="inline-flex items-center gap-2 text-white/60 hover:text-white mb-8 transition-colors text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        All Summits
      </a>

      <div class="grid lg:grid-cols-12 gap-12 items-center max-w-7xl mx-auto">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-crn-green/15 border border-crn-green/40 rounded-full text-crn-green text-xs font-semibold uppercase tracking-wider mb-6">
            {recordingsAvailable ? 'Past Event · Watch Recordings' : 'Past Event · Recordings Coming Soon'}
          </div>
          <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-6">
            Climate Robotics
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-crn-green via-emerald-400 to-teal-300">Summit 2026</span>
          </h1>
          <p class="text-lg md:text-xl text-white/75 max-w-2xl mb-6 leading-relaxed">{summit?.tagline}</p>
          <div class="flex flex-wrap gap-6 text-white/70 mb-10 text-sm">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              {summit?.dates}
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
              {summit?.location}
            </span>
          </div>
          <a
            href={LINKS.summit.agenda2026Pdf}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-white text-crn-navy font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-crn-green hover:text-white transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Download Full Agenda
          </a>
        </div>

        <div class="lg:col-span-5">
          <div class="grid grid-cols-3 gap-3">
            {keynoteSpeakers.filter(s => s.photoUrl).slice(0, 3).map((s, i) => (
              <div class={`aspect-[3/4] rounded-2xl overflow-hidden ring-1 ring-white/15 shadow-2xl ${i === 1 ? 'translate-y-6' : ''}`}>
                <img src={s.photoUrl} alt={s.name} class="w-full h-full object-cover" loading="eager" />
              </div>
            ))}
          </div>
          <div class="mt-6 text-center text-xs uppercase tracking-[0.2em] text-white/50">
            Three Keynotes
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Recordings notice */}
  {!recordingsAvailable && (
    <section class="bg-yellow-50 border-y border-yellow-200 py-4">
      <div class="container mx-auto px-4">
        <p class="text-center text-yellow-900 text-sm">
          <strong>Recordings coming soon.</strong> Session videos will be published on our
          <a href="https://www.youtube.com/@ClimateRoboticsNetwork" target="_blank" rel="noopener" class="underline hover:no-underline">YouTube channel</a>
          and added here as soon as they're ready.
        </p>
      </div>
    </section>
  )}

  {/* Tab Navigation */}
  <div class="sticky top-[72px] z-40 bg-white border-b border-gray-200 shadow-sm">
    <div class="container mx-auto px-4">
      <nav class="flex gap-1 overflow-x-auto scrollbar-hide py-2" aria-label="Summit sections">
        {tabs.map((tab, idx) => (
          <button
            class={`summit-tab flex items-center gap-2 px-6 py-3 font-semibold text-sm uppercase tracking-wide whitespace-nowrap rounded-lg transition-colors ${idx === 0 ? 'bg-crn-blue text-white' : 'text-gray-600 hover:bg-gray-100'}`}
            data-tab={tab.id}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tab.icon} />
            </svg>
            {tab.label}
          </button>
        ))}
      </nav>
    </div>
  </div>

  {/* Tab Content */}
  <div class="min-h-screen">
    {/* Program Tab */}
    <section id="tab-program" class="summit-tab-content py-16">
      <div class="container mx-auto px-4">
        <h2 class="section-title mb-4">3-Day Program</h2>
        <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
          Click any day to expand the session list. Times are shown in UTC.
        </p>

        <div class="max-w-4xl mx-auto space-y-4">
          {SUMMIT_2026_PROGRAM.map((day, idx) => (
            <ProgramDay programDay={day} defaultOpen={idx === 0} />
          ))}
        </div>
      </div>
    </section>

    {/* Speakers Tab */}
    <section id="tab-speakers" class="summit-tab-content py-16 hidden">
      <div class="container mx-auto px-4">
        <h2 class="section-title mb-4">Keynote Speakers</h2>
        <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
          Three keynotes anchored the summit across the three days.
        </p>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto mb-16">
          {keynoteSpeakers.map(speaker => (
            <SpeakerCard speaker={speaker} size="lg" />
          ))}
        </div>

        <h3 class="text-2xl font-heading font-semibold text-center mb-8">All Speakers</h3>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 max-w-6xl mx-auto">
          {SPEAKERS_2026.filter(s => !s.isKeynote).map(speaker => (
            <SpeakerCard speaker={speaker} size="sm" />
          ))}
        </div>
      </div>
    </section>

    {/* Sponsors Tab */}
    <section id="tab-sponsors" class="summit-tab-content py-16 hidden bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="section-title mb-4">Our Sponsors & Partners</h2>
        <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
          Thank you to the organizations that made Summit 2026 possible.
        </p>

        <div class="max-w-5xl mx-auto">
          <SponsorGrid sponsors={SPONSORS_2026} />
        </div>
      </div>
    </section>
  </div>

  {/* Past Summits CTA */}
  <section class="py-16 bg-crn-blue">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-4">
        Catch Up on Summit 2025
      </h2>
      <p class="text-white/80 mb-8 max-w-xl mx-auto">
        While 2026 recordings are being prepared, browse all 33 sessions from our 2025 summit.
      </p>
      <a
        href="/summits/2025"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-crn-blue font-semibold uppercase tracking-wider hover:bg-gray-100 transition-colors rounded-lg"
      >
        View Summit 2025 Archive
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Tab switching
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.summit-tab');
    const contents = document.querySelectorAll('.summit-tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');

        tabs.forEach(t => {
          t.classList.remove('bg-crn-blue', 'text-white');
          t.classList.add('text-gray-600', 'hover:bg-gray-100');
        });
        tab.classList.add('bg-crn-blue', 'text-white');
        tab.classList.remove('text-gray-600', 'hover:bg-gray-100');

        contents.forEach(content => {
          if (content.id === `tab-${targetId}`) {
            content.classList.remove('hidden');
          } else {
            content.classList.add('hidden');
          }
        });

        const targetContent = document.getElementById(`tab-${targetId}`);
        if (targetContent) {
          window.scrollTo({
            top: targetContent.offsetTop - 140,
            behavior: 'smooth',
          });
        }
      });
    });

    const hash = window.location.hash.replace('#', '');
    if (hash) {
      const targetTab = document.querySelector(`.summit-tab[data-tab="${hash}"]`) as HTMLElement;
      if (targetTab) targetTab.click();
    }
  });
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
