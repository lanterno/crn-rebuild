---
/**
 * Summits Landing Page
 * Modern, content-forward layout: spotlight on latest summit + video archive,
 * past-summit timeline, organizers, impact numbers.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import TeamCard from '@/components/TeamCard.astro';
import {
  SUMMITS,
  ORGANIZERS,
  SPEAKERS_2026,
  SUMMIT_2026_PROGRAM,
  SUMMIT_2025_VIDEOS,
  getKeynoteSpeakers,
} from '@/lib/summits-data';
import { LINKS, YOUTUBE } from '@/lib/constants';

const allSummits = Object.values(SUMMITS).sort(
  (a, b) => parseInt(b.year) - parseInt(a.year)
);
const upcomingSummit = allSummits.find(s => s.status === 'upcoming');
const latestPastSummit = allSummits.find(s => s.status === 'past');
const olderPastSummits = allSummits.filter(
  s => s.status === 'past' && s.year !== latestPastSummit?.year
);

const featuredSpeakers = [
  ...getKeynoteSpeakers('2026'),
  ...SPEAKERS_2026.filter(s => s.photoUrl && !s.isKeynote).slice(0, 9),
].filter(s => s.photoUrl).slice(0, 8);

const heroMosaicSpeakers = featuredSpeakers.slice(0, 6);

// 2026 session topics (the visual chips)
const summit2026Topics = [
  { label: 'Energy Infrastructure', color: 'from-amber-500 to-orange-600' },
  { label: 'Biodiversity', color: 'from-emerald-500 to-green-600' },
  { label: 'Earth & Ocean Observations', color: 'from-blue-500 to-cyan-600' },
  { label: 'Funding Climate Robotics', color: 'from-violet-500 to-purple-600' },
  { label: 'Recycling Management', color: 'from-rose-500 to-pink-600' },
  { label: 'Built Environment', color: 'from-slate-500 to-zinc-600' },
  { label: 'Water Access & Conservation', color: 'from-teal-500 to-blue-500' },
];

const totalSessionsCount =
  SUMMIT_2026_PROGRAM.reduce((acc, day) => acc + day.sessions.length, 0);
const speakers2026Count = SPEAKERS_2026.length;
---

<BaseLayout
  title="Climate Robotics Summits"
  description="The Climate Robotics Summit — three annual events convening researchers, engineers, entrepreneurs, and policymakers to scale climate action through robotics."
>
  {/* ─── HERO ─── */}
  <section class="relative overflow-hidden bg-crn-navy text-white">
    {/* Background gradient + grain */}
    <div class="absolute inset-0 bg-gradient-to-br from-crn-navy via-crn-blue-dark to-crn-blue"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 20% 20%, rgba(22,163,74,0.25), transparent 40%), radial-gradient(circle at 80% 80%, rgba(59,130,246,0.25), transparent 40%);"></div>
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: url('data:image/svg+xml,%3Csvg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cpath d=\"M0 39h40M39 0v40\" stroke=\"%23ffffff\" stroke-width=\"1\" fill=\"none\"/%3E%3C/svg%3E');"></div>

    <div class="relative container mx-auto px-4 py-20 lg:py-28">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        {/* Left: copy */}
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-crn-green/15 border border-crn-green/40 rounded-full text-crn-green text-xs font-semibold uppercase tracking-wider mb-6">
            <span class="w-1.5 h-1.5 bg-crn-green rounded-full"></span>
            {upcomingSummit ? 'Next Edition' : `Latest: ${latestPastSummit?.dates}`}
          </div>
          <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-6">
            How Can Robotics
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-crn-green to-teal-300">Scale Climate Action?</span>
          </h1>
          <p class="text-lg md:text-xl text-white/75 max-w-2xl mb-10 leading-relaxed">
            The Climate Robotics Summit convenes researchers, entrepreneurs, and policymakers across three days of keynotes, panels, and pitches — exploring how autonomy and AI can address the climate crisis.
          </p>
          <div class="flex flex-wrap gap-3">
            {latestPastSummit && (
              <a
                href={`/summits/${latestPastSummit.year}`}
                class="inline-flex items-center gap-2 px-6 py-3.5 bg-white text-crn-navy font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-crn-green hover:text-white transition-colors"
              >
                Explore Summit {latestPastSummit.year}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            )}
            <a
              href={LINKS.social.youtube}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-white/20 transition-colors"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              Watch on YouTube
            </a>
          </div>
        </div>

        {/* Right: speaker mosaic */}
        <div class="lg:col-span-5">
          <div class="relative grid grid-cols-3 gap-3 max-w-md ml-auto">
            {heroMosaicSpeakers.map((s, i) => (
              <div class={`aspect-square rounded-2xl overflow-hidden ring-1 ring-white/20 shadow-2xl ${i === 1 ? 'translate-y-6' : ''} ${i === 4 ? '-translate-y-6' : ''} ${i === 3 ? 'translate-y-4' : ''}`}>
                <img
                  src={s.photoUrl}
                  alt={s.name}
                  class="w-full h-full object-cover"
                  loading="eager"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── LATEST SUMMIT SPOTLIGHT ─── */}
  {latestPastSummit && (
    <section class="py-20 lg:py-28 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-12 gap-12 items-start max-w-7xl mx-auto">
          {/* Left: copy + chips */}
          <div class="lg:col-span-7">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-blue mb-3">
              Most Recent Edition
            </div>
            <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-4 leading-tight">
              {latestPastSummit.name}
            </h2>
            <p class="text-lg text-gray-600 mb-2">{latestPastSummit.dates} · {latestPastSummit.location}</p>
            <p class="text-gray-600 mb-8 max-w-2xl">{latestPastSummit.description}</p>

            {/* Topic chips */}
            <div class="flex flex-wrap gap-2 mb-10">
              {summit2026Topics.map(topic => (
                <span class={`inline-block px-3 py-1.5 text-xs font-semibold text-white rounded-full bg-gradient-to-r ${topic.color}`}>
                  {topic.label}
                </span>
              ))}
            </div>

            {/* Inline stats */}
            <div class="grid grid-cols-3 gap-6 mb-10 max-w-md">
              <div>
                <div class="font-heading font-bold text-4xl text-crn-blue">{SUMMIT_2026_PROGRAM.length}</div>
                <div class="text-xs uppercase tracking-wider text-gray-500 mt-1">Days</div>
              </div>
              <div>
                <div class="font-heading font-bold text-4xl text-crn-blue">{totalSessionsCount}</div>
                <div class="text-xs uppercase tracking-wider text-gray-500 mt-1">Sessions</div>
              </div>
              <div>
                <div class="font-heading font-bold text-4xl text-crn-blue">{speakers2026Count}+</div>
                <div class="text-xs uppercase tracking-wider text-gray-500 mt-1">Speakers</div>
              </div>
            </div>

            <a
              href={`/summits/${latestPastSummit.year}`}
              class="inline-flex items-center gap-2 px-6 py-3 bg-crn-blue text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-crn-blue-dark transition-colors"
            >
              View Program & Speakers
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>

          {/* Right: Speaker mosaic */}
          <div class="lg:col-span-5">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400 mb-4">
              Featured Speakers
            </div>
            <div class="grid grid-cols-3 gap-3">
              {featuredSpeakers.slice(0, 6).map(s => (
                <a href={`/summits/${latestPastSummit.year}#speakers`} class="group block aspect-square rounded-xl overflow-hidden bg-gray-100 relative">
                  <img
                    src={s.photoUrl}
                    alt={s.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                    <span class="text-white text-xs font-semibold leading-tight">{s.name}</span>
                  </div>
                </a>
              ))}
            </div>
            <a href={`/summits/${latestPastSummit.year}#speakers`} class="inline-flex items-center gap-1 text-crn-blue font-semibold text-sm uppercase tracking-wider mt-4 hover:underline">
              See all {speakers2026Count} speakers →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* ─── WATCH 2025 PLAYLIST ─── */}
  <section class="py-20 lg:py-28 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 30% 40%, rgba(22,163,74,0.4), transparent 50%);"></div>
    <div class="relative container mx-auto px-4">
      <div class="grid lg:grid-cols-12 gap-10 items-center max-w-7xl mx-auto">
        <div class="lg:col-span-5">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-green mb-3">
            On-Demand Library
          </div>
          <h2 class="font-heading font-bold text-4xl md:text-5xl mb-4 leading-tight">
            Watch the Full
            <span class="block text-crn-green">2025 Archive</span>
          </h2>
          <p class="text-white/70 text-lg mb-8 leading-relaxed">
            {SUMMIT_2025_VIDEOS.length} recorded sessions across four days — keynotes, panels on biodiversity, agriculture, ocean robotics, ethics, policy, and the future of climate robotics.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/summits/2025"
              class="inline-flex items-center gap-2 px-6 py-3 bg-crn-green text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-crn-green-dark transition-colors"
            >
              Browse All Sessions
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a
              href={`https://www.youtube.com/playlist?list=${YOUTUBE.playlists.summit2025}`}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 border border-white/20 text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-white/20 transition-colors"
            >
              <svg class="w-5 h-5 text-red-500" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              YouTube
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="aspect-video rounded-2xl overflow-hidden shadow-2xl ring-1 ring-white/10">
            <iframe
              src={YOUTUBE.getPlaylistEmbedUrl(YOUTUBE.playlists.summit2025)}
              title="Climate Robotics Summit 2025 Playlist"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full"
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── SUMMIT TIMELINE ─── */}
  <section class="py-20 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-blue mb-3">
          The Summit Archive
        </div>
        <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-4">
          Every Edition, In One Place
        </h2>
        <p class="text-gray-600 text-lg">
          Each summit builds on the last. Browse recordings, programs, and speaker rosters from every year.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {allSummits.map((summit, idx) => (
          <a
            href={`/summits/${summit.year}`}
            class="group relative overflow-hidden rounded-2xl bg-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1"
          >
            {/* Year backdrop */}
            <div class={`absolute inset-0 bg-gradient-to-br ${summit.year === '2026' ? 'from-crn-blue via-crn-blue-dark to-crn-navy' : 'from-gray-700 via-gray-800 to-gray-900'} opacity-95`}></div>
            <div class="absolute -bottom-8 -right-4 font-heading font-bold text-[12rem] leading-none text-white/[0.08]">
              {summit.year}
            </div>

            <div class="relative p-8 md:p-10 text-white min-h-[280px] flex flex-col">
              <div class="flex items-center gap-2 mb-4">
                <span class={`inline-block w-2 h-2 rounded-full ${summit.status === 'upcoming' ? 'bg-crn-green animate-pulse' : 'bg-white/40'}`}></span>
                <span class="text-xs uppercase tracking-wider font-semibold">
                  {summit.status === 'upcoming' ? 'Upcoming' : 'Watch Recordings'}
                </span>
              </div>
              <h3 class="font-heading font-bold text-3xl md:text-4xl mb-2 leading-tight">
                {summit.name}
              </h3>
              <p class="text-white/70 mb-1">{summit.dates}</p>
              <p class="text-white/60 text-sm mb-6">{summit.tagline}</p>

              {summit.stats && (
                <div class="flex gap-6 mt-auto pt-4 border-t border-white/20">
                  <div>
                    <div class="font-heading font-bold text-2xl">{summit.stats.attendees}</div>
                    <div class="text-xs uppercase tracking-wider text-white/60">Attendees</div>
                  </div>
                  <div>
                    <div class="font-heading font-bold text-2xl">{summit.stats.sessions}</div>
                    <div class="text-xs uppercase tracking-wider text-white/60">Sessions</div>
                  </div>
                  <div>
                    <div class="font-heading font-bold text-2xl">{summit.stats.countries}</div>
                    <div class="text-xs uppercase tracking-wider text-white/60">Countries</div>
                  </div>
                </div>
              )}

              <div class="mt-auto pt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider group-hover:gap-3 transition-all">
                Open
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ─── ORGANIZERS ─── */}
  <section id="team" class="py-20 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between mb-12 max-w-5xl mx-auto gap-4">
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-blue mb-3">
            The Team
          </div>
          <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 leading-tight">
            Organizers & Volunteers
          </h2>
        </div>
        <p class="text-gray-600 max-w-md lg:text-right">
          The Climate Robotics Summit is made possible by an international team that gives their time year-round.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-4 max-w-5xl mx-auto">
        {ORGANIZERS.map(member => (
          <TeamCard member={member} />
        ))}
      </div>
    </div>
  </section>

  {/* ─── IMPACT NUMBERS ─── */}
  <section class="py-20 bg-crn-navy text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-crn-navy via-crn-blue-dark to-crn-navy"></div>
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 70% 30%, rgba(22,163,74,0.3), transparent 50%);"></div>
    <div class="relative container mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-crn-green mb-3">
          By the Numbers
        </div>
        <h2 class="font-heading font-bold text-4xl md:text-5xl mb-4">
          Three years. Global reach.
        </h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-crn-green mb-2 tabular-nums">3</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Summits Held</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-crn-green mb-2 tabular-nums">1,000+</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Total Attendees</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-crn-green mb-2 tabular-nums">60+</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Sessions</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-crn-green mb-2 tabular-nums">40+</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Countries</div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── SLACK CTA ─── */}
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="relative overflow-hidden bg-gradient-to-br from-crn-blue to-crn-blue-dark rounded-3xl max-w-5xl mx-auto p-10 md:p-16">
        <div class="absolute top-0 right-0 w-64 h-64 bg-crn-green/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/10 rounded-full blur-2xl translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h2 class="font-heading font-bold text-3xl md:text-4xl text-white mb-3 leading-tight">
              Want to hear about the next Summit?
            </h2>
            <p class="text-white/80 text-lg">
              Join our Slack community — that's where we announce dates, share recordings, and connect speakers and attendees year-round.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a
              href="/slack"
              class="inline-flex items-center gap-3 px-8 py-4 bg-white text-crn-blue font-bold uppercase tracking-wider rounded-lg hover:bg-crn-green hover:text-white transition-colors shadow-xl"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/>
              </svg>
              Join Our Slack
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
